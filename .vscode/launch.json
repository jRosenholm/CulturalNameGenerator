{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Launch CulturalNameGenerator",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build-app",
        "program": "${workspaceFolder}/bin/Debug/net10.0/CulturalNameGenerator.dll",
        "args": [ 
            "--urls", "http://localhost:3000/"
        ],
        "cwd": "${workspaceFolder}",
        "stopAtEntry": false,
        "serverReadyAction": {
			"action": "openExternally",
			"pattern": "Now listening on:\\s+(https?://\\S+)",
			"uriFormat": "%s/index.html"
		},
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        },
        "sourceFileMap": {
          "/Views": "${workspaceFolder}"
        }
      }
    ]
  }